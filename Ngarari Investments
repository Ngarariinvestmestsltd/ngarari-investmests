      "*Phone:* " + encodeURIComponent(enquiry.phone) + "%0A" +
      "*Additional Details:* " + encodeURIComponent(enquiry.details);

    window.open(
      "https://wa.me/254731404288?text=" + message,
      "_blank"
    );
  }

