        </div>
      </div>
    `;
  }


  function setLocation(location) {

    enquiry.location = location;

    const chat = document.getElementById("chat");

    chat.innerHTML = `
      <div class="bot-message">

        <div class="question">
          Location: ${location}
        </div>

        <p style="margin-bottom:15px;">
          What is your approximate budget or value involved?
