          <button class="choice" onclick="setBudget('KSh 1 Million - 5 Million')">
            KSh 1M - 5M
          </button>

          <button class="choice" onclick="setBudget('Above KSh 5 Million')">
            Above KSh 5M
          </button>

          <button class="choice" onclick="setBudget('To be discussed')">
            Not sure / Discuss
          </button>

        </div>

      </div>
    `;
  }


  function setBudget(budget) {

    enquiry.budget = budget;

    const chat = document.getElementById("chat");

    chat.innerHTML = `
      <div class="bot-message">

        <div class="question">
          Almost done! Please give us your contact details.
        </div>

        <div class="form-group">
          <label>Your Name</label>
          <input id="clientName" type="text" placeholder="Enter your name">
