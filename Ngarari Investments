      align-items: center;
      gap: 12px;
    }

    .logo-box {
      width: 48px;
      height: 48px;
      border: 2px solid var(--red);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      color: var(--red);
      font-size: 17px;
      background: white;
    }

    .brand-name {
      font-weight: 800;
      font-size: 18px;
      color: var(--navy);
      line-height: 1.2;
    }

    .brand-name span {
      display: block;
      color: var(--red);
      font-size: 12px;
      letter-spacing: 2px;
      margin-top: 3px;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 22px;
      align-items: center;
    }

    nav ul a {
      color: var(--navy);
      font-weight: 600;
      font-size: 14px;
    }

    nav ul a:hover {
      color: var(--red);
    }

    .menu-btn {
      display: none;
      font-size: 27px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--navy);
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      padding: 150px 22px 90px;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: white;

      background:
        linear-gradient(rgba(8,17,38,0.80), rgba(8,17,38,0.84)),
        url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85")
        center/cover;
    }

    .hero-content {
      max-width: 950px;
    }

    .eyebrow {
      color: #f0d36b;
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 4px;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.05;
      letter-spacing: 1px;
      margin-bottom: 25px;
    }

    .hero h1 span {
      color: #e33a51;
    }

    .hero p {
      font-size: 20px;
      max-width: 800px;
      margin: 0 auto 32px;
      color: #f1f3f7;
    }

    .hero-buttons {
      margin-top: 10px;
    }

    .btn {
      display: inline-block;
      padding: 14px 25px;
      margin: 6px;
      border-radius: 5px;
      font-weight: bold;
      transition: 0.25s;
    }

    .btn-primary {
      background: var(--red);
      color: white;
    }

    .btn-primary:hover {
      background: #8e182a;
      transform: translateY(-2px);
    }

    .btn-outline {
      border: 1px solid white;
      color: white;
    }

    .btn-outline:hover {
      background: white;
      color: var(--navy);
    }

    /* GENERAL */
    section {
      padding: 90px 22px;
    }

    .container {
      max-width: 1150px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 48px;
    }

    .section-title h2 {
      font-size: 40px;
      line-height: 1.2;
      margin-bottom: 12px;
    }

    .section-title p {
      color: var(--muted);
      max-width: 720px;
      margin: auto;
    }

    /* TRUST STRIP */
    .trust {
      background: var(--navy);
      color: white;
      padding: 25px 20px;
    }

    .trust-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 20px;
      text-align: center;
    }

    .trust-item strong {
      display: block;
      font-size: 20px;
      color: #f0d36b;
    }

    .trust-item span {
      font-size: 13px;
      color: #d7dce7;
    }

    /* SERVICES */
    .services {
      background: var(--light);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 24px;
    }

    .card {
      background: white;
      padding: 32px 27px;
      border-radius: 9px;
      box-shadow: 0 7px 28px rgba(0,0,0,0.07);
      border-top: 4px solid var(--red);
      transition: 0.25s;
    }

    .card:hover {
      transform: translateY(-6px);
    }

    .icon {
      font-size: 38px;
      margin-bottom: 12px;
    }

    .card h3 {
      font-size: 22px;
      margin-bottom: 10px;
    }

    .card p {
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 16px;
    }

    .small-link {
      color: var(--red);
      font-weight: bold;
    }

    /* ABOUT */
    .about {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 55px;
      align-items: center;
    }

    .about-image {
      min-height: 430px;
      border-radius: 10px;
      background:
        linear-gradient(rgba(10,20,45,0.15),rgba(10,20,45,0.15)),
        url("https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=85")
        center/cover;
    }

    .about h2 {
      font-size: 40px;
      line-height: 1.2;
      margin-bottom: 20px;
    }

    .about p {
      color: #596477;
    }

    .values {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 25px;
    }

    .value {
      padding: 14px;
      background: var(--light);
      border-left: 4px solid var(--red);
      font-weight: bold;
      font-size: 14px;
    }

    /* PROPERTY */
    .property {
      background: #fff;
    }

    .property-box {
      background: var(--navy);
      color: white;
      border-radius: 12px;
      padding: 50px 35px;
      text-align: center;
    }

    .property-box h2 {
      font-size: 36px;
      margin-bottom: 15px;
    }

    .property-box p {
      max-width: 760px;
      margin: auto auto 25px;
      color: #dce2ed;
    }

    .property-options {
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 12px;
      max-width: 850px;
      margin: 25px auto;
    }

    .property-option {
      background: white;
      color: var(--navy);
      padding: 16px 10px;
      border-radius: 6px;
      font-weight: bold;
    }

    /* PRICING */
    .pricing {
      background: var(--light);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 22px;
    }

    .price-card {
      background: white;
      padding: 28px;
      border-radius: 8px;
      box-shadow: 0 5px 22px rgba(0,0,0,0.06);
    }

    .price-card h3 {
      margin-bottom: 8px;
    }

    .price {
      color: var(--red);
      font-weight: bold;
      font-size: 19px;
      margin-bottom: 10px;
    }

    .price-card p {
      color: var(--muted);
      font-size: 14px;
    }

    .notice {
      margin-top: 25px;
      padding: 18px;
      background: #fff8df;
      border-left: 4px solid var(--gold);
      color: #5b4a16;
      font-size: 14px;
    }

    /* ENQUIRY BOT */
    .assistant {
      background: white;
    }

    .assistant-box {
      max-width: 800px;
      margin: auto;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
      overflow: hidden;
      border: 1px solid #e3e7ee;
    }

    .assistant-head {
      background: var(--navy);
      color: white;
      padding: 24px;
      text-align: center;
    }

    .assistant-head h3 {
      font-size: 24px;
    }

    .assistant-head p {
      color: #cbd2df;
      font-size: 14px;
    }

    .chat {
      padding: 25px;
      min-height: 310px;
    }

    .bot-message {
      background: var(--light);
      padding: 14px 16px;
      border-radius: 10px;
      margin-bottom: 18px;
      max-width: 90%;
    }

    .question {
      font-weight: bold;
      margin-bottom: 15px;
    }

    .choices {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
    }

    .choice {
      border: 1px solid #ccd3df;
      background: white;
      padding: 10px 14px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
      color: var(--navy);
    }

    .choice:hover {
      border-color: var(--red);
      color: var(--red);
    }

    .form-group {
      margin-bottom: 13px;
    }

    .form-group label {
      display: block;
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 5px;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccd3df;
      border-radius: 5px;
      font-family: inherit;
    }

    .form-group textarea {
      min-height: 80px;
      resize: vertical;
    }

    /* LOCATION */
    .location {
      background: var(--light);
    }

    .location-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }

    .location-card {
      background: white;
      padding: 30px;
      border-radius: 9px;
    }

    .location-card h3 {
      margin-bottom: 12px;
    }

    .contact-line {
      margin: 12px 0;
    }

    .contact-line strong {
      display: block;
      color: var(--red);
    }

    .map {
      min-height: 330px;
      border-radius: 9px;
      overflow: hidden;
    }

    .map iframe {
      width: 100%;
      height: 100%;
      min-height: 330px;
      border: 0;
    }

    /* FOOTER */
    footer {
      background: #091126;
      color: #b9c1cf;
      text-align: center;
      padding: 28px 20px;
    }

    footer strong {
      color: white;
    }

    /* WHATSAPP */
    .whatsapp {
      position: fixed;
      right: 20px;
      bottom: 20px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #25D366;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 29px;
      z-index: 999;
      box-shadow: 0 5px 20px rgba(0,0,0,0.25);
    }

    /* MOBILE */
    @media(max-width: 850px) {

      nav {
        position: relative;
      }

      .menu-btn {
        display: block;
      }

      nav ul {
        display: none;
        position: absolute;
        top: 75px;
        left: 0;
        width: 100%;
        background: white;
        flex-direction: column;
        gap: 0;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
      }

      nav ul.show {
        display: flex;
      }

      nav ul li {
        width: 100%;
        border-top: 1px solid #eee;
      }

      nav ul a {
        display: block;
        padding: 14px 22px;
      }

      .cards,
      .about,
      .pricing-grid,
      .location-grid {
        grid-template-columns: 1fr;
      }

      .trust-grid {
        grid-template-columns: 1fr 1fr;
      }

      .property-options {
        grid-template-columns: 1fr 1fr;
      }

      .hero h1 {
        font-size: 43px;
      }

      .hero p {
        font-size: 17px;
      }

      section {
        padding: 70px 18px;
      }

      .section-title h2,
      .about h2 {
        font-size: 32px;
      }

      .about-image {
        min-height: 300px;
      }
    }

    @media(max-width: 480px) {
      .brand-name {
        font-size: 15px;
      }

      .logo-box {
        width: 42px;
        height: 42px;
      }

      .trust-grid,
      .property-options,
      .values {
        grid-template-columns: 1fr;
      }

      .property-box {
        padding: 35px 20px;
      }

      .property-box h2 {
        font-size: 29px;
      }
    }
  </style>
</head>

