      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    :root {
      --navy: #101b35;
      --navy2: #172544;
      --red: #b51f35;
      --red2: #d6283f;
      --light: #f5f7fa;
      --gold: #c9a227;
      --text: #18233d;
      --muted: #657083;
      --white: #ffffff;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background: white;
      line-height: 1.7;
    }

    a {
      text-decoration: none;
    }

    /* HEADER */
    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      background: rgba(255,255,255,0.98);
      z-index: 1000;
      box-shadow: 0 2px 18px rgba(0,0,0,0.08);
    }

    nav {
